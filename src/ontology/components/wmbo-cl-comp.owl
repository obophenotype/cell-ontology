        <obo:CLM_0010001 rdf:resource="https://purl.brain-bican.org/ontology/mbao/MBA_679"/>
        <obo:CLM_0010001 rdf:resource="https://purl.brain-bican.org/ontology/mbao/MBA_771"/>
