    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4306489"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A GABA-Gly neuron of the Mus musculus brain. It is distinguished from other cells in the brain by selective expression of Brs3 (Mmus), Hmcn1 (Mmus), Meis2 (Mmus). It is distinguished from other P GABA cells by expression of Brs3, Hmcn1, Meis2. It is GABAergic and glycinergic (inferred from expression of Gad2, Gad1, Slc32a1, Slc6a5). These cells are located in the Medulla, Pons , in or close to the regions: Pontine reticular nucleus, caudal part, Intermediate reticular nucleus . Reference transcriptomic data for this type can be found in the dataset/taxonomy - Yao et al. (2023), Whole Mouse Brain in cell set Cluster:4669 PRNc Prox1 Brs3 Gly-Gaba_1.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1038/s41586-023-06808-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://doi.org/10.1038/s41586-023-06812-z</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4306489"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>1228 PRNc_Otp:Prox1:Brs3_Gly-Gaba 1</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CCN20251031:CS20251031_SUPT_1228</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4306489"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Rationale for assigning this type to reference data: Assigned by automated classification (ELK) of a definition built from soma location Hindbrain (HB; ≥80% of grey-matter cells in both the Yao 2023 and Zhuang 2023 MERFISH atlases) and neurotransmitter GABA + glycine (all clusters) against CL 2026-06-08. Basis: NT. Other inferred CL parents: central nervous system neuron. [WMBO CL promotion round 1, 2026-10-13] Location is inferred from registration of MerFish Data. Registration may be inaccurate, giving misleading location to adjacent anatomical regions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1038/s41586-023-06808-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://doi.org/10.1038/s41586-023-06812-z</oboInOwl:hasDbXref>
