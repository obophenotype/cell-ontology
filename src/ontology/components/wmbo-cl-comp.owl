    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4307016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Purkinje cell of the Mus musculus brain. It is distinguished from other cells in the brain by selective expression of Pcp2 (Mmus), Slc9a3 (Mmus), Grin2a (Mmus). It is distinguished from other CBX Purkinje Gaba_2 cells by expression of Sphk1. It is GABAergic (inferred from expression of Gad1, Gad2, Slc32a1). These cells are located in the Cerebellum , in or close to the regions: Simple lobule, Crus 2, brain . Reference transcriptomic data for this type can be found in the dataset/taxonomy - Yao et al. (2023), Whole Mouse Brain in cell set Cluster:5196 CBX Purkinje Gaba_2.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1038/s41586-023-06812-z</oboInOwl:hasDbXref>
    </owl:Axiom>
