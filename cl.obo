synonym: "MAL" RELATED Gene-based []
synonym: "T-cell surface glycoprotein Lyt-2" EXACT []
synonym: "T-lymphocyte differentiation antigen T8/Leu-2" EXACT []
is_a: PR:000000001 ! protein

