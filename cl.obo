synonym: "primitive ventricle" EXACT [EHDAA2:0001531]
synonym: "primitive ventricle of heart" EXACT [EMAPA:16350]
synonym: "primordial cardiac ventricle" EXACT [FMA:71006]
synonym: "primordial ventricle" EXACT [FMA:71006]
