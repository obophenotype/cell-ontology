relationship: RO:0002170 UBERON:0001533 ! connected to subclavian artery
property_value: foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/b/b3/Costocervical_trunk_with_branches.png" xsd:anyURI
property_value: RO:0002175 NCBITaxon:9606
property_value: skos:prefLabel "costo-cervical trunk" xsd:string

