[Term]
id: CL:0000625
name: CD8-positive, alpha-beta T cell
def: "A T cell expressing an alpha-beta T cell receptor and the CD8 coreceptor." [GOC:add, GOC:tfm, ISBN:0781735149]
subset: cellxgene_subset
