xref: EMAPA:36569
xref: FMA:61259
xref: MA:0002809
xref: NCIT:C32336
xref: UMLS:C0931689 {source="ncithesaurus:Cochlear_Labyrinth"}
xref: Wikipedia:Cochlear_labyrinth
