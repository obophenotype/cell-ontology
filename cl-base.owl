    <!-- http://purl.obolibrary.org/obo/CL_0002664 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000048"/>
        <obo:IAO_0000115>A stem cell that can give rise to multiple cell types (i.e. smooth muscle, endothelial) in the developing heart.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-07-11T03:15:38Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>cardiovascular progenitor cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>CPC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Discrepancy in develops from origins prevents me from making the assertion that cardioblasts give rise to all instances of cardiocytes as we state cardiac muscle cells develop from cardiac myoblast, which in turn develop from muscle stem cell.</rdfs:comment>
        <rdfs:label>cardioblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002664"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
