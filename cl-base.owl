        <obo:IAO_0000115>A specialized epithelial cell that contains &quot;feet&quot; that interdigitate with the &quot;feet&quot; of other glomerular epithelial cells in the metanephros.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-02-08T02:02:13Z</oboInOwl:creation_date>
