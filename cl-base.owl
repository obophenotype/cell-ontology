        <oboInOwl:hasExactSynonym>resting histiocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>tissue-resident macrophage</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000864</rdfs:seeAlso>
    </owl:Class>
