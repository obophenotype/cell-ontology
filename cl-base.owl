        <obo:IAO_0000115>An enteric neuron whose soma resides in the myenteric plexus and which is capable of nitric oxide biosynthetic process. This is a defined grouping class that autoclassifies spiny Dogiel type I neurons (the nitrergic motor neuron morphotype).</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/cell-ontology/issues/3471"/>
        <terms:creator>GitHub Copilot</terms:creator>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-10T14:42:58Z</terms:date>
        <oboInOwl:hasExactSynonym>NOS1-positive myenteric neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nNOS-positive myenteric neuron</oboInOwl:hasExactSynonym>
        <rdfs:label>nitrergic neuron of myenteric plexus</rdfs:label>
    </owl:Class>
