        <oboInOwl:hasDbXref>CALOHA:TS-0012</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63880</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009082</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adipose cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fat cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>adipocyte</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000136</rdfs:seeAlso>
        <skos:prefLabel>adipocyte</skos:prefLabel>
    </owl:Class>
