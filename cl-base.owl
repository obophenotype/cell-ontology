    <!-- http://purl.obolibrary.org/obo/CL_4033027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4033027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000750"/>
