        <oboInOwl:hasExactSynonym>renin secreting cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>kidney granular cell</rdfs:label>
    </owl:Class>
