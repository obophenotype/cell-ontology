    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002064">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000622"/>
                    <owl:Restriction>
