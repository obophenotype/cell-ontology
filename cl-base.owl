        <oboInOwl:hasDbXref>PMID:30904566</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4052034"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>A thymic tuft cell is a subset of terminally differentiated medullary thymic epithelial cell comprising 5-10% of total mTECs. Lineage-tracing studies indicate that this cell arises from mature MHCII mTECs, with development occurring through both Aire-dependent and Aire-independent pathways. However, its exact origins remain unclear.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:30904566</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_4052035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4052035">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
