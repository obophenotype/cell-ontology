    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000855"/>
        <rdfs:subClassOf>
            <owl:Restriction>
