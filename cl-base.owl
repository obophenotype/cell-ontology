    <!-- http://purl.obolibrary.org/obo/CL_0000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000123"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000710"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1100001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0031201"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0007269"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A specialized epithelial cell located in the skin epidermis and certain mucosal epithelia. It functions as a mechanoreceptor for light touch by forming synapse-like contacts with somatosensory afferent nerve endings, contributing to slowly adapting type I (SAI) tactile responses. Characterized by dense-core neuroendocrine granules, the Merkel cell exhibits both sensory and neuroendocrine properties, including regulated neurotransmitter release via SNARE complex-dependent mechanisms. Its development in mice depends on the transcription factor Atoh1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:70548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009146</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Merkel&apos;s cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>MC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>Merkel cell</rdfs:label>
        <foaf:depiction>https://cdn.humanatlas.io/digital-objects/2d-ftu/skin-epidermal-ridge/v1.2/assets/2d-ftu-skin-epidermal-ridge.png</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000242"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A specialized epithelial cell located in the skin epidermis and certain mucosal epithelia. It functions as a mechanoreceptor for light touch by forming synapse-like contacts with somatosensory afferent nerve endings, contributing to slowly adapting type I (SAI) tactile responses. Characterized by dense-core neuroendocrine granules, the Merkel cell exhibits both sensory and neuroendocrine properties, including regulated neurotransmitter release via SNARE complex-dependent mechanisms. Its development in mice depends on the transcription factor Atoh1.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MESH:D018862</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:19834574</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:2274847</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:24862916</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:30415995</oboInOwl:hasDbXref>
