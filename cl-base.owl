    <!-- http://purl.obolibrary.org/obo/CL_4042028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4042028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000029"/>
        <obo:IAO_0000115>A neuron in the central nervous system that is not committed to a differentiated fate, has not been newly derived from neurogenesis, and does not integrate into any circuit.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0098-8958"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-10-10T09:14:45Z</terms:date>
        <oboInOwl:hasRelatedSynonym>IN</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is hypothesised that immature neurons can be utilised as a neurogenic reserve and that they can be involved in circuit plasticity.</rdfs:comment>
        <rdfs:label xml:lang="en">immature neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
