    <!-- http://purl.obolibrary.org/obo/CL_4023055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4023055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000049"/>
