            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002203"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0002494"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mesenchymal cell found in the developing heart and that develops into some part of the heart.  These cells derive from intra- and extra-cardiac sources, including the endocardium, epicardium, neural crest, and second heart field.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ZFA:0009259</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>cardiac mesenchymal cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000569"/>
