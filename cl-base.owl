    <!-- http://purl.obolibrary.org/obo/CL_4052022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4052022">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
