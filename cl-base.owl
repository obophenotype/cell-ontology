        <oboInOwl:hasExactSynonym>equine chorionic girdle cell</oboInOwl:hasExactSynonym>
        <rdfs:comment>Humans, mice and rats have a highly invasive (hemochorial) placentation. Horses have a non-invasive epitheliochorial placenta, except for the transient endometrial cup.</rdfs:comment>
        <rdfs:label>chorionic girdle cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4040001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
