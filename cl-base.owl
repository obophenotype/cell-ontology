        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002494"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
