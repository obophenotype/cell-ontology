    <!-- http://purl.obolibrary.org/obo/CL_0011111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0011111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000165"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0012001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002596"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0032274"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>a specialized neuroendocrine cell that synthesizes and secretes GnRH decapeptide, a key regulator of reproductive function. It originates from the olfactory placode during embryonic development and migrates into the forebrain where it localises predominantly in the hypothalamus and in humans, in extrahypothalamic regions like the basal ganglia (Skrapits et al., 2021). This cell regulates reproduction by secreting GnRH into the pituitary portal vessels to induce the release of gonadotropins into the general circulation. It expresses receptor subunits required for AMPA, NMDA, and kainate receptor signaling and may use glutamate as a neurotransmitter in recurrent collateral innervation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>GnRH neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>GnRH-secreting neuron</oboInOwl:hasExactSynonym>
        <rdfs:label>hypothalamic gonadotropin-releasing hormone neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0011111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>a specialized neuroendocrine cell that synthesizes and secretes GnRH decapeptide, a key regulator of reproductive function. It originates from the olfactory placode during embryonic development and migrates into the forebrain where it localises predominantly in the hypothalamus and in humans, in extrahypothalamic regions like the basal ganglia (Skrapits et al., 2021). This cell regulates reproduction by secreting GnRH into the pituitary portal vessels to induce the release of gonadotropins into the general circulation. It expresses receptor subunits required for AMPA, NMDA, and kainate receptor signaling and may use glutamate as a neurotransmitter in recurrent collateral innervation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:NV</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20807514</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21828096</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26053743</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:34128468</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:35067985</oboInOwl:hasDbXref>
