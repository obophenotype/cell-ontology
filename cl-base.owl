    <!-- http://purl.obolibrary.org/obo/CL_0000491 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000491">
        <obo:IAO_0000115>OBSOLETE: A cell responsible for spontaneous cytotoxicity of a variety of tumor cells without prior immunization. These natural killer cells are found in non-immune humans and experimental animals and are thought by some to be the same as killer cells (killing by antibody-dependent cell cytotoxicity), but they can also kill in the absence of antibody.</obo:IAO_0000115>
        <rdfs:comment>This term had an incorrect definition and was overly broad. Consider using &apos;cytotoxic T cell ; CL:0000910&apos; (in most cases) or another lymphocyte cell type if cytotoxicity is shown to be part of the cell&apos;s phenotype in a particular experimental situation.</rdfs:comment>
        <rdfs:label>obsolete cytotoxic T cell</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000492">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000624"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
