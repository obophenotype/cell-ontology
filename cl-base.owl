        <oboInOwl:hasExactSynonym>B-2 B-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B-2 B-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B2 B cell</oboInOwl:hasExactSynonym>
