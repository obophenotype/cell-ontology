        <oboInOwl:hasDbXref>FMA:68458</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>LEC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lymphatic endothelial cell</oboInOwl:hasExactSynonym>
