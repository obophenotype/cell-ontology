        <oboInOwl:hasExactSynonym>Th22 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>helper T cell type 22</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>TH22 cells are also reportedly CCR4-positive, CCR6-positive, CCR10-positive, CXCR3-negative. TH22 cells are reportedly capable of secreting IL-13.</rdfs:comment>
        <rdfs:label>T-helper 22 cell</rdfs:label>
