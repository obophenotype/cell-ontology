    <!-- http://purl.obolibrary.org/obo/CL_0000751 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000749"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002102"/>
