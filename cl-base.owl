    <!-- http://purl.obolibrary.org/obo/CL_4040001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4040001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011101"/>
        <obo:IAO_0000115>A horse-specific, highly invasive trophoblast cell that invades the endometrium where it forms endometrial cups.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9789"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0819-0473"/>
