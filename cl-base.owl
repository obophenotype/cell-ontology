    <!-- http://purl.obolibrary.org/obo/CL_4047043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4047043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4040002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009566"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An enteric glial cell that is associated with neuron cell bodies within submucosal ganglia of the gastrointestinal tract. This cell is located in the submucosa, a layer of connective tissue beneath the intestinal mucosa. This cell plays a role in modulating secretomotor neuron activity and contributes to the regulation of digestive fluid secretion and absorption.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-7919-4905"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-10T17:02:28Z</terms:date>
        <oboInOwl:hasRelatedSynonym>type I SMP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>type 1 submucosal plexus glia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4047043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An enteric glial cell that is associated with neuron cell bodies within submucosal ganglia of the gastrointestinal tract. This cell is located in the submucosa, a layer of connective tissue beneath the intestinal mucosa. This cell plays a role in modulating secretomotor neuron activity and contributes to the regulation of digestive fluid secretion and absorption.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.3389/fncel.2023.1170309</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:28487635</oboInOwl:hasDbXref>
