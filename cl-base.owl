    <!-- http://purl.obolibrary.org/obo/CL_4047007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4047007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000669"/>
        <obo:IAO_0000115>A pericyte that is in an early stage of development, found in newly forming or remodeling blood vessels. An immature pericyte is characterized by it&apos;s mesenchymal stem cell-like properties and high proliferative capacity, which allows it to differentiate into various types of pericytes and contribute to the structural and functional maturation of the vasculature. Immature pericytes are stellate in new vessels and elongated with less protrusions in remodeling vessels.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-7919-4905"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-19T11:32:32Z</terms:date>
        <oboInOwl:hasRelatedSynonym>imPCs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>immature PCs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>immature pericyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4047007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pericyte that is in an early stage of development, found in newly forming or remodeling blood vessels. An immature pericyte is characterized by it&apos;s mesenchymal stem cell-like properties and high proliferative capacity, which allows it to differentiate into various types of pericytes and contribute to the structural and functional maturation of the vasculature. Immature pericytes are stellate in new vessels and elongated with less protrusions in remodeling vessels.</owl:annotatedTarget>
