        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4072022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Despite being clustered as CGE in this dataset, other studies suggest that the cell is of MGE origin because it expresses transcription factors such as LHX6 and NKX2-1, which are hallmark indicators of MGE-derived interneurons. Fate mapping experiments in mice have demonstrated that Lamp5+/Lhx6+ interneurons in both the hippocampus and neocortex arise from the MGE, and single-cell transcriptomic comparisons further show that primate neocortical Lamp5+/Lhx6+ cells closely resemble mouse hippocampal MGE-derived interneurons rather than classic CGE-derived types.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32999462</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4072022"/>
