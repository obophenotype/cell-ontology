    <!-- http://purl.obolibrary.org/obo/CL_0002299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002364"/>
        <obo:IAO_0000115>An epithelial cell scattered in the cortex, predominant in the outer cortex with a large pale nucleus and a prominent nucleolus.</obo:IAO_0000115>
