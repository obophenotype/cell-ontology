        <oboInOwl:hasDbXref>FMA:67761</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>KUPO:0001095</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>arterial endothelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>endothelial cell of artery</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1000413</rdfs:seeAlso>
    </owl:Class>
