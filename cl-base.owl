                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000007489"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A type of tanycyte located in the floor of third ventricle and the infindibular recess. This tanycyte has an elongated morphology with multiple microvilli extending medially and ventrally to the median eminence, contacting the pial surface and blood vessels. This type of tanycyte expresses FGF receptors 1 and 2, is in contact with GnRH neurons, and is involved in the release of gonadotropin-releasing hormone (GnRH).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0098-8958"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-19T13:21:39Z</terms:date>
        <oboInOwl:hasRelatedSynonym>ME tanycyte</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">beta2-tanycyte</rdfs:label>
        <foaf:depiction rdf:resource="http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg"/>
        <foaf:depiction rdf:resource="http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg"/>
    </owl:Class>
    <owl:Axiom>
