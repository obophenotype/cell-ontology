    <!-- http://purl.obolibrary.org/obo/CL_0020046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0007011"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_3000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002100"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002439"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory neuron of the enteric nervous system whose soma resides in the myenteric plexus and which functions as the afferent limb of intrinsic reflex circuits controlling motility, secretion, and blood flow. This neuron is characterised by Dogiel type II morphology (large smooth soma with multiple long axon-like processes), AH-type electrophysiology (prolonged afterhyperpolarization following an action potential), and is immunopositive for choline acetyltransferase (ChAT) and immunonegative for neuronal nitric oxide synthase (NOS1).</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/cell-ontology/issues/3471"/>
        <terms:creator>GitHub Copilot</terms:creator>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-10T14:42:58Z</terms:date>
        <oboInOwl:hasExactSynonym>multiaxonal cholinergic myenteric sensory neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myenteric sensory neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>IPAN</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intrinsic primary afferent neuron of myenteric plexus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020046"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sensory neuron of the enteric nervous system whose soma resides in the myenteric plexus and which functions as the afferent limb of intrinsic reflex circuits controlling motility, secretion, and blood flow. This neuron is characterised by Dogiel type II morphology (large smooth soma with multiple long axon-like processes), AH-type electrophysiology (prolonged afterhyperpolarization following an action potential), and is immunopositive for choline acetyltransferase (ChAT) and immunonegative for neuronal nitric oxide synthase (NOS1).</owl:annotatedTarget>
