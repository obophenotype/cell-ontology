    <!-- http://purl.obolibrary.org/obo/CL_4052016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4052016">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0002144"/>
                    <owl:Restriction>
