        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002299"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An epithelial cell scattered in the cortex, predominant in the outer cortex with a large pale nucleus and a prominent nucleolus.</owl:annotatedTarget>
