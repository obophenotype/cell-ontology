                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005927"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A specialized muscle nucleus that is part of an extrafusal muscle fiber and overlaps the muscle-tendon junction, where muscle fibers connect to tendons. Characterized by a distinct transcriptional profile with the expression of genes like COL22A1, this myonucleus supports the structural integrity and function of the junction, playing a key role in transmitting the force generated by muscle contraction to the tendon.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0001-6947-615X"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-10-30T13:47:39Z</terms:date>
        <oboInOwl:hasExactSynonym>myotendinous junction myonuclei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myotendinous junction nuclei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>MTJ nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>myotendinous junction nucleus</rdfs:label>
    </owl:Class>
