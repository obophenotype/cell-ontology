        <oboInOwl:hasExactSynonym>sublingual gland tuft cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>brush cell of sublingual gland</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tuft cell of sublingual gland</rdfs:label>
    </owl:Class>
