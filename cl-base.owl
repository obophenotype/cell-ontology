        <oboInOwl:hasExactSynonym>endometrial ciliated epithelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endometrium ciliated epithelial cell</oboInOwl:hasExactSynonym>
        <rdfs:comment>In human samples, the expression of FOXJ1 protein, a regulator for motile cilia with epithelial lineage identity, has been noted.</rdfs:comment>
        <rdfs:label>endometrial multiciliated epithelial cell</rdfs:label>
    </owl:Class>
