        <oboInOwl:hasDbXref>ZFA:0007122</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>epidermal stem cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>stem cell of epidermis</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1000428</rdfs:seeAlso>
    </owl:Class>
