    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002639">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000134"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002323"/>
        <obo:IAO_0000115>An amniotic stem cell is a mesenchymalstem cell extracted from amniotic fluid. Amniotic stem cells are able to differentiate into various tissue type such as skin, cartilage, cardiac tissue, nerves, muscle, and bone</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-06-21T03:55:39Z</oboInOwl:creation_date>
        <rdfs:comment>Not clear to me if amniotic stem cell is a different cell type from amnion mesenchymal stem cells. They are treated as distinct in the literature as isolations methods are different, so I will keep them as separate terms for now.</rdfs:comment>
        <rdfs:label>amniotic stem cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002639"/>
