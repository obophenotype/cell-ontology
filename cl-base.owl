    <!-- http://purl.obolibrary.org/obo/CL_0020051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0020047"/>
        <obo:IAO_0000115>An interneuron of the myenteric plexus whose axon projects aborally (in the descending direction) along the gut axis. This neuron class encompasses multiple chemically diverse subtypes including serotonergic (5-HT+), nitrergic (NOS1+), and other populations, forming the inhibitory limb of descending reflex pathways.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/cell-ontology/issues/3471"/>
        <terms:creator>GitHub Copilot</terms:creator>
