        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000820"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A B-1 B cell that has the phenotype CD5-positive.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:add</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:11861604</oboInOwl:hasDbXref>
