        <oboInOwl:hasExactSynonym>goblet cell of epithelium of large intestine</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>large intestine goblet cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1000320</rdfs:seeAlso>
    </owl:Class>
