    <!-- http://purl.obolibrary.org/obo/CL_0002290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000019"/>
        <obo:IAO_0000115>A sperm bearing a Y chromosome. Chromosomal and genetic sex is established at fertilization in mammals and depends upon whether an X-bearing sperm or a Y-bearing sperm fertilizes the X-bearing ovum.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-13T11:35:24Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>FMA:84058</oboInOwl:hasDbXref>
