    <!-- http://purl.obolibrary.org/obo/CL_4047048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4047048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4040002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006660"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An enteric glial cell characterized by a small central soma that extends long, thin, bipolar projections. This cell is primarily located along small nerve fibers within the muscle layers of the gastrointestinal tract and is known for its unbranching processes that closely follow these nerve fibers in the muscularis.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-7919-4905"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-18T11:14:25Z</terms:date>
        <oboInOwl:hasRelatedSynonym>intramuscular glia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>type 4 muscularis propria glia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4047048"/>
