        <oboInOwl:hasExactSynonym>plasma B cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plasma B-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plasmacyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plasmocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>effector B cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>effector B-cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#blood_and_immune_upper_slim"/>
