    <!-- http://purl.obolibrary.org/obo/CL_4030059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030059">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_4023040"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002100"/>
