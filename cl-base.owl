        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000630"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002167"/>
        <obo:IAO_0000115>Olfactory epithelial support cell is a columnar cell that extends from the epithelial free margin to the basement membrane of the olfactory epithelium. This cell type has a large, vertically, elongate, euchromatic nucleus, along with other nuclei, forms a layer superficial to the cell body of the receptor cell; sends long somewhat irregular microvilli into the mucus layer; at the base, with expanded end-feet containing numerous lamellated dense bodies resembling lipofuscin of neurons.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:62302</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009364</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>olfactory epithelial support cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>olfactory sustentacular cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>supporting cell of olfactory epithelium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sustentaculocyte of olfactory epithelium</oboInOwl:hasExactSynonym>
        <rdfs:label>olfactory epithelial supporting cell</rdfs:label>
        <skos:prefLabel>olfactory epithelial supporting cell</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000853"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Olfactory epithelial support cell is a columnar cell that extends from the epithelial free margin to the basement membrane of the olfactory epithelium. This cell type has a large, vertically, elongate, euchromatic nucleus, along with other nuclei, forms a layer superficial to the cell body of the receptor cell; sends long somewhat irregular microvilli into the mucus layer; at the base, with expanded end-feet containing numerous lamellated dense bodies resembling lipofuscin of neurons.</owl:annotatedTarget>
