        <owl:annotatedTarget>neuromuscular junction myonuclei</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:33311464</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003004"/>
    </owl:Axiom>
