    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000605"/>
        <obo:IAO_0000115>An asexual 1-celled spore (primarily for perennation, not dissemination). Originates endogenously and singly within part of a pre-existing cell by the contraction of the protoplast. Possesses an inner secondary and often thickened hyaline or brown wall, usually impregnated with hydrophobic material.</obo:IAO_0000115>
        <rdfs:comment>Considering obsoleting as sometimes used to refer to protozoans too. But reference indicates term was intended for fungus.</rdfs:comment>
        <rdfs:label>chlamydospore</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
