        <oboInOwl:hasRelatedSynonym>astrocyte precursor cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In vitro, this progenitor cell can differentiate from glial-restricted precursor cells.</rdfs:comment>
        <rdfs:label xml:lang="en">astrocyte-restricted precursor</rdfs:label>
    </owl:Class>
