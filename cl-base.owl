        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-01-06T03:43:27Z</oboInOwl:creation_date>
        <rdfs:label>hematopoietic oligopotent progenitor cell, lineage-negative</rdfs:label>
