        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002488"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A trophoblast cell that has a large volume of cytoplasm, is polyploid and is usually mononuclear but is also occasionally multi-nucleate. This cell type is important in establishing maternal physiology and remodeling of the vasculature of the placenta.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
