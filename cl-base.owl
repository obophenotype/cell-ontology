        <oboInOwl:hasExactSynonym>Tc17 CD8+ T cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tc17 T cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tc17 T lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tc17 T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tc17 T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th17 CD8-positive T cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th17 non-TFH CD8-positive T cell</oboInOwl:hasExactSynonym>
        <rdfs:comment>This cell type is compatible with the HIPC Lyoplate markers for &apos;Tc17 CD8+ T cell&apos;, but its logical definition includes additional known characteristics of Tc17 T cells.  Found in the CD27-positive, CD28-positive or CD27-negative, CD28-positive fractions with the phenotype CCR4-negative and CCR7-negative (this sentence not part of definition).</rdfs:comment>
        <rdfs:label>Tc17 cell</rdfs:label>
