    <!-- http://purl.obolibrary.org/obo/CL_0008037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0008037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008039"/>
        <rdfs:subClassOf>
            <owl:Restriction>
