    <!-- http://purl.obolibrary.org/obo/CL_0020022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000138"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002207"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000743"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A post-proliferative chondrocyte in the prehypertrophic zone of the cartilage tissue, located between the proliferative and hypertrophic zones. This cell is characterised by increased cell volume and expression of Indian Hedgehog (Ihh), PTH1R, and Runx2/3 in both humans and mice (Hallett et al., 2021). It coordinates the PTHrP-Ihh feedback loop that regulates chondrocyte differentiation and functions as a signalling hub for communication between proliferative chondrocytes, hypertrophic chondrocytes, and periosteal osteoblasts (Hallett et al., 2021).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <oboInOwl:hasRelatedSynonym>preHTC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>prehypertrophic chondrocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A post-proliferative chondrocyte in the prehypertrophic zone of the cartilage tissue, located between the proliferative and hypertrophic zones. This cell is characterised by increased cell volume and expression of Indian Hedgehog (Ihh), PTH1R, and Runx2/3 in both humans and mice (Hallett et al., 2021). It coordinates the PTHrP-Ihh feedback loop that regulates chondrocyte differentiation and functions as a signalling hub for communication between proliferative chondrocytes, hypertrophic chondrocytes, and periosteal osteoblasts (Hallett et al., 2021).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29985449</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:31871141</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:34137454</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
