    <!-- http://purl.obolibrary.org/obo/CL_2000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_2000027">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000118"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002100"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002037"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000118"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4042035"/>
        <obo:IAO_0000115>A GABAergic inhibitory interneuron located in the molecular layer of the cerebellar cortex. It projects axons that form specialized synaptic structures around Purkinje cells, including pericellular baskets, which wrap around the Purkinje cell soma, and the pinceau: a brush-like terminal that contacts the initial segment of the Purkinje cell axon. The basket cell modulates Purkinje cell activity through both chemical (GABAergic) and non-synaptic (ephaptic) mechanisms. It is arranged in sagittal rows that align with Purkinje cell zones, contributing to the cerebellum&apos;s modular and topographically organized architecture. It plays an essential role in regulating motor coordination and potentially cognitive functions.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://www.wikidata.org/entity/Q35563349"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2014-06-25T00:24:03Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>cerebellum basket cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:2000027</oboInOwl:id>
        <rdfs:label>cerebellar basket cell</rdfs:label>
        <foaf:depiction rdf:resource="http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png"/>
        <foaf:depiction rdf:resource="http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.png"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_2000027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A GABAergic inhibitory interneuron located in the molecular layer of the cerebellar cortex. It projects axons that form specialized synaptic structures around Purkinje cells, including pericellular baskets, which wrap around the Purkinje cell soma, and the pinceau: a brush-like terminal that contacts the initial segment of the Purkinje cell axon. The basket cell modulates Purkinje cell activity through both chemical (GABAergic) and non-synaptic (ephaptic) mechanisms. It is arranged in sagittal rows that align with Purkinje cell zones, contributing to the cerebellum&apos;s modular and topographically organized architecture. It plays an essential role in regulating motor coordination and potentially cognitive functions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32990595</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:8915580</oboInOwl:hasDbXref>
    </owl:Axiom>
