    <!-- http://purl.obolibrary.org/obo/CL_0000431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
