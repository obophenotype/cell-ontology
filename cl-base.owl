    <!-- http://purl.obolibrary.org/obo/CL_4072041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4072041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4030065"/>
