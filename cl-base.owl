        <oboInOwl:hasExactSynonym>undifferentiated medullary thymic epithelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>undifferentiated thymic epithelial cell</oboInOwl:hasExactSynonym>
        <rdfs:label>type-5 epithelial cell of thymus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
