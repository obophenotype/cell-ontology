        <owl:annotatedTarget>A cuboidal epithelial cell of the kidney that regulates acid/base balance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:CVS</oboInOwl:hasDbXref>
    </owl:Axiom>
