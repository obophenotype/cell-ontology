    <!-- http://purl.obolibrary.org/obo/CL_4042025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4042025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002614"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000097"/>
        <obo:IAO_0000115>A midbrain dopaminergic neuron that has its soma located in a substantia nigra. This dopaminergic neuron type is highly metabolically active and it is involved in the regulation of movement, cognition, motivation and reward. Neurodegeneration of this dopaminergic neuronal type causes loss in fine motor control in Parkinson&apos;s Disease.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0098-8958"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-09-16T13:09:29Z</terms:date>
        <oboInOwl:hasNarrowSynonym>SNpc dopaminergic neuron</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label xml:lang="en">substantia nigra dopaminergic neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4042025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A midbrain dopaminergic neuron that has its soma located in a substantia nigra. This dopaminergic neuron type is highly metabolically active and it is involved in the regulation of movement, cognition, motivation and reward. Neurodegeneration of this dopaminergic neuronal type causes loss in fine motor control in Parkinson&apos;s Disease.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32826893</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:35308118</oboInOwl:hasDbXref>
    </owl:Axiom>
