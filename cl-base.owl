        <owl:annotatedTarget>https://cellxgene.cziscience.com/cellguide/CL_0001071</owl:annotatedTarget>
        <rdfs:label>group 3 innate lymphoid cell on CELLxGENE CellGuide</rdfs:label>
    </owl:Axiom>
    


