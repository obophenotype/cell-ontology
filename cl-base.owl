        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023162"/>
        <obo:IAO_0000115>A bushy cell that receives a large number of medium-sized synapses, called modified endbulbs. Globular bushy cells extend to the superior olive on both sides of the brainstem where they give input to the bipolar neurons.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasExactSynonym>GBC</oboInOwl:hasExactSynonym>
