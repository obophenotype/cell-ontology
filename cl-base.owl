            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A granulosa cell that is undergoing atresia. This cell type displays distinct morphological alterations compared with a healthy granulosa cell, including pyknosis (nuclear condensation) and cellular shrinkage.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
