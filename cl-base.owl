    <!-- http://purl.obolibrary.org/obo/CL_4042019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4042019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002085"/>
