    <!-- http://purl.obolibrary.org/obo/CL_0011101 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0011101">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000351"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
