                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000002104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory neuron that has the soma located in the dorsal root ganglion and expresses the marker sodium channel protein type 9 subunit alpha (Nav1.7/SCN9A). Nav1.7 accounts for approximately 50% of total sodium channel expression in human DRG and is present in 54-57% of TrkA-positive nociceptors.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-05T00:00:00Z</terms:date>
        <oboInOwl:hasExactSynonym>DRG Nav1.7 neuron</oboInOwl:hasExactSynonym>
        <rdfs:label>dorsal root ganglion Nav1.7 neuron</rdfs:label>
    </owl:Class>
