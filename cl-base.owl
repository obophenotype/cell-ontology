        <owl:annotatedTarget>https://cellxgene.cziscience.com/cellguide/CL_0000956</owl:annotatedTarget>
        <rdfs:label>pre-B-I cell on CELLxGENE CellGuide</rdfs:label>
    </owl:Axiom>
    


