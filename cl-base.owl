        <oboInOwl:id>CL:2000018</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>endothelial cell of coronary artery</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_2000018</rdfs:seeAlso>
    </owl:Class>
