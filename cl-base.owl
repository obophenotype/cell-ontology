    <!-- http://purl.obolibrary.org/obo/CL_4033030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4033030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000750"/>
