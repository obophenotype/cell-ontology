    <!-- http://purl.obolibrary.org/obo/CL_0020073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000617"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000700"/>
