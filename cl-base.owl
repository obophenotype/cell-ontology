    <!-- http://purl.obolibrary.org/obo/CL_0000642 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000630"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000004"/>
