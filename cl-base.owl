        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#kidney_upper_slim"/>
        <rdfs:label>kidney loop of Henle descending limb epithelial cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1001021</rdfs:seeAlso>
    </owl:Class>
