        <oboInOwl:hasDbXref>doi:10.1101/2022.03.16.484460</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020009"/>
