        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000003490"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A CD8 T cell characterized by high expression of Granzyme H (GZMH). This cell exhibits a restricted TCR repertoire and elevated expression of cytotoxic, exhaustion, and type I interferon-stimulated gene signatures compared to controls.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-3958-7465"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-10T10:14:31Z</terms:date>
        <oboInOwl:hasExactSynonym>granzyme H+ CD8 T cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>GZMH+ CD8+ T cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This cell type is significantly expanded in systemic lupus erythematosus (SLE) patients. Unlike other CD8 T cell populations, GZMH+ CD8 T cells can comprise up to 50% of all lymphocytes in some SLE patients.</rdfs:comment>
        <rdfs:label>granzyme H-associated CD8 T cell</rdfs:label>
    </owl:Class>
