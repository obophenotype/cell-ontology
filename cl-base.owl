        <oboInOwl:hasDbXref>PMID:25045600</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:28067220</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:37008045</oboInOwl:hasDbXref>
    </owl:Axiom>
