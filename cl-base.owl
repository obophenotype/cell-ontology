    <!-- http://purl.obolibrary.org/obo/CL_1000742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1000742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000234"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000650"/>
