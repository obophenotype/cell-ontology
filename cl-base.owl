    <!-- http://purl.obolibrary.org/obo/CL_4072013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4072013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000700"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011005"/>
