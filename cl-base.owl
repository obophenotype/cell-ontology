            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A class switched memory B cell is a memory B cell that has undergone Ig class switching and therefore is IgM-negative on the cell surface. These cells are CD27-positive and have either IgG, IgE, or IgA on the cell surface.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>class switched memory B lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>class switched memory B-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>class switched memory B-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Per DSD: Class switched memory B cells are also reportedly CD48-positive, CD229-positive, and CD352-positive.</rdfs:comment>
        <rdfs:label>class switched memory B cell</rdfs:label>
    </owl:Class>
