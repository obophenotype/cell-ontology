        <oboInOwl:hasDbXref>BTO:0004519</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>myometrium smooth muscle cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>myometrial cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0002366</rdfs:seeAlso>
    </owl:Class>
