        <oboInOwl:hasRelatedSynonym>mesenchymal progenitor cells</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mesenchymal stem cell</oboInOwl:hasRelatedSynonym>
