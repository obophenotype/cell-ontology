    <!-- http://purl.obolibrary.org/obo/CL_4030013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1001111"/>
        <rdfs:subClassOf>
