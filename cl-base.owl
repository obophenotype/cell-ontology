    <!-- http://purl.obolibrary.org/obo/CL_0002198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002076"/>
        <obo:IAO_0000115>A large epithelial cell with an extremely acidophilic and granular cytoplasm, containing vast numbers of mitochondria; such cells may undergo neoplastic transformation. From the Greek word onkos meaning swelling, this cell type is found in parathyroid, salivary and thyroid glands.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-02T11:26:49Z</oboInOwl:creation_date>
