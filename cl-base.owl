                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000429"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An enteric glial cell that has an elongated, fibrous morphology with long processes that run parallel to nerve fibers connecting enteric myenteric ganglia. This cell is located in the interganglionic fiber tracts of the enteric nervous system.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-7919-4905"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-11T12:28:37Z</terms:date>
        <oboInOwl:hasExactSynonym>type II enteric glia</oboInOwl:hasExactSynonym>
        <rdfs:label>type 2 interganglionic glia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4047044"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An enteric glial cell that has an elongated, fibrous morphology with long processes that run parallel to nerve fibers connecting enteric myenteric ganglia. This cell is located in the interganglionic fiber tracts of the enteric nervous system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.1002/glia.22876</oboInOwl:hasDbXref>
