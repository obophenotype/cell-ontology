        <oboInOwl:hasExactSynonym>gastrointestinal tract (lamina propria) lymphocyte of small intestine</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lamina propria lymphocyte of small intestine</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>small intestine lamina propria lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#location_grouping"/>
