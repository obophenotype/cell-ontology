        <oboInOwl:hasDbXref>ZFA:0009013</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>unipotent stem cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>unipotential stem cell</oboInOwl:hasExactSynonym>
        <rdfs:label>single fate stem cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000035</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000035"/>
