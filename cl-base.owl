    <!-- http://purl.obolibrary.org/obo/CL_0020036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000740"/>
        <obo:IAO_0000115>A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together OFF midget RGCs from primate foveal and peripheral retina with their molecularly homologous mouse alpha RGC subtype (OFF-sustained alpha-RGC, C42) (Hahn et al., 2023; Tran et al., 2019). Reference to the transcriptomic evidence is found at: GSE237215.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5507-2103"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-08T11:40:49Z</terms:date>
        <oboInOwl:id>CL:9900001</oboInOwl:id>
        <rdfs:label>oRGC1</rdfs:label>
        <rdfs:seeAlso>https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE237215</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020036"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together OFF midget RGCs from primate foveal and peripheral retina with their molecularly homologous mouse alpha RGC subtype (OFF-sustained alpha-RGC, C42) (Hahn et al., 2023; Tran et al., 2019). Reference to the transcriptomic evidence is found at: GSE237215.</owl:annotatedTarget>
