            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A luteal cell that is part of the young, developing corpus luteum. This cell promotes progesterone synthesis, marked by high Parm1 expression in mice (Lan et al., 2024). An early luteal cell is associated with steroidogenesis and cell growth, contributing to early corpus luteum function and maturation.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-03-05T16:40:18Z</terms:date>
        <oboInOwl:hasExactSynonym>active corpus luteum cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#added_by_HRA"/>
        <rdfs:label>early luteal cell</rdfs:label>
    </owl:Class>
