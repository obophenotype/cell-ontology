        <owl:annotatedTarget>subcerebral projection (SCPN) neuron (Homo sapiens)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.1016/j.neuron.2005.08.030</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4072043"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Pyramidal tract-like (PT-l) (Homo sapiens)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31626774</oboInOwl:hasDbXref>
        <rdfs:comment>pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.</rdfs:comment>
    </owl:Axiom>
