    <!-- http://purl.obolibrary.org/obo/CL_0020067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
