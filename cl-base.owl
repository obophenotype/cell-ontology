                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005377"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A type of dopaminergic interneuron located in the glomerular layer of the main olfactory bulb, characterized by the co-release of dopamine and GABA, and involved in modulating sensory input within olfactory circuits.</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-06T13:12:14Z</terms:date>
        <rdfs:label>A16 dopaminergic neuron</rdfs:label>
