        <owl:annotatedTarget>MOL</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:27284195</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


