        <owl:annotatedTarget>In Rhesus macaques, the Island of Calleja granule cell type has been noted to have enriched gene expression of CPNE4.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>doi:10.1016/j.cub.2021.10.015</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_4030054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002613"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1001474"/>
