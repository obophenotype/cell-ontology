    <!-- http://purl.obolibrary.org/obo/CL_4072001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4072001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000123"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000128"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002207"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_4023059"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5507-2103"/>
        <oboInOwl:hasRelatedSynonym>NFOL</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">newly formed oligodendrocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4072001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:27284195</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:39233334</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4072001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
