            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000007643"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000013047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000014898"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A GABAergic interneuron that has its soma in the anterior section of the substantia nigra pars reticulata. This GABAergic interneuron is characterized by the expression of Six3 and Foxp1 and it develops from Nkx6-2 expressing neuronal progenitors in the ventrolateral midbrain-diencephalon region.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0098-8958"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-09-23T13:56:01Z</terms:date>
        <oboInOwl:hasRelatedSynonym>aSNpr</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">GABAergic interneuron of the anterior substantia nigra pars reticulata</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4042026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A GABAergic interneuron that has its soma in the anterior section of the substantia nigra pars reticulata. This GABAergic interneuron is characterized by the expression of Six3 and Foxp1 and it develops from Nkx6-2 expressing neuronal progenitors in the ventrolateral midbrain-diencephalon region.</owl:annotatedTarget>
