    <!-- http://purl.obolibrary.org/obo/CL_4052010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4052010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002132"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002174"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
