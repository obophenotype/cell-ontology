        <oboInOwl:hasDbXref>ZFA:0009235</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>myoblast, smooth muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>satellite cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>smooth muscle myoblast</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000514</rdfs:seeAlso>
        <skos:prefLabel>smooth muscle myoblast</skos:prefLabel>
    </owl:Class>
