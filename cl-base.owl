        <obo:IAO_0000115>A multinucleate cell formed by the fusion of multiple uninuclear cells through plasma membrane fusion. This process leads to a single large cell containing multiple nuclei within a shared cytoplasm.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-08-15T10:38:46Z</terms:date>
