                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_Q12918"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mucosal-associated invariant T (MAIT) cell found in various tissues including human blood, liver, gut, and lung, characterised by a semi-invariant T cell receptor (TCR) comprising TRAV1-2 (Vα7.2) predominantly paired with TRAJ33, and high expression of CD161. Upon activation, MAIT cells produce inflammatory cytokines, including IFN-γ, TNF-α, and IL-17.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-5742-4697"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-10-07T00:00:00Z</terms:date>
        <oboInOwl:hasExactSynonym>mucosal-associated invariant T lymphocyte, human</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosal-associated invariant T-cell, human</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosal-associated invariant T-lymphocyte, human</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>MAIT, human</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mucosal-associated invariant T cell, human</rdfs:label>
    </owl:Class>
