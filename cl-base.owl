    <!-- http://purl.obolibrary.org/obo/CL_4047044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4047044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4040002"/>
        <rdfs:subClassOf>
