    <!-- http://purl.obolibrary.org/obo/CL_0000609 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002374"/>
        <obo:IAO_0000115>A mechanoreceptor located in the acoustic maculae and the semicircular canals that mediates the sense of balance, movement, and head position. The vestibular hair cells are connected to accessory structures in such a way that movements of the head displace their stereocilia. This influences the membrane potential of the cells which relay information about movements via the vestibular part of the vestibulocochlear nerve to the brain stem.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:62351</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vestibular receptor cell</oboInOwl:hasExactSynonym>
        <rdfs:label>vestibular hair cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000609"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mechanoreceptor located in the acoustic maculae and the semicircular canals that mediates the sense of balance, movement, and head position. The vestibular hair cells are connected to accessory structures in such a way that movements of the head displace their stereocilia. This influences the membrane potential of the cells which relay information about movements via the vestibular part of the vestibulocochlear nerve to the brain stem.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D018069</oboInOwl:hasDbXref>
    </owl:Axiom>
    


