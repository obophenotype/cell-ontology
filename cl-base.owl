        <obo:IAO_0000115>A columnar, mucin-producing cholangiocyte that lines large bile ducts, including the hilar bile duct, right and left hepatic bile ducts, and large intrahepatic bile ducts. This cell expresses phosphorylated STAT3 and TFF-3 in humans and mice.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-7919-4905"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-03-20T14:21:41Z</terms:date>
        <oboInOwl:hasNarrowSynonym>mucin-secreting cholangiocyte</oboInOwl:hasNarrowSynonym>
        <rdfs:label>large mucus secreting cholangiocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
