        <oboInOwl:hasDbXref>BTO:0002046</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0949</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00004954</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:67338</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBbt:0006798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009006</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sperm cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spermatozoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spermatozoon</oboInOwl:hasExactSynonym>
        <rdfs:label>sperm</rdfs:label>
