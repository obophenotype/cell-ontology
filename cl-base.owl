    <!-- http://purl.obolibrary.org/obo/CL_4047047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4047047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4040002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001809"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An enteric glial cell located within the ganglia of the enteric nervous system. This cell is characterized by it’s small somata and short, irregularly branched processes that surround neuronal cell bodies in the myenteric and submucosal ganglia. This cell plays important roles in modulating neuronal activity and neurogenesis in the gastrointestinal tract.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-7919-4905"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-11T13:35:14Z</terms:date>
        <oboInOwl:hasExactSynonym>intraganglionic glia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>type 1 enteric glia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>type I enteric glia</oboInOwl:hasExactSynonym>
        <rdfs:label>type I enteric glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4047047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An enteric glial cell located within the ganglia of the enteric nervous system. This cell is characterized by it’s small somata and short, irregularly branched processes that surround neuronal cell bodies in the myenteric and submucosal ganglia. This cell plays important roles in modulating neuronal activity and neurogenesis in the gastrointestinal tract.</owl:annotatedTarget>
