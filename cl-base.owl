        <oboInOwl:hasBroadSynonym>suppressor T lymphocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>suppressor T-cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>suppressor T-lymphocyte</oboInOwl:hasBroadSynonym>
