    <!-- http://purl.obolibrary.org/obo/CL_0008038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0008038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008039"/>
        <rdfs:subClassOf>
            <owl:Restriction>
