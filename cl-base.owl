                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000028>L6b glut (Homo sapiens)</obo:IAO_0000028>
        <obo:IAO_0000115>A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: &apos;Transcriptomic cytoarchitecture reveals principles of human neocortex organization&apos;, dataset: &apos;Supercluster: Deep layer (non-IT) excitatory neuron&apos;, Author Categories: &apos;CrossArea_subclass&apos;, cluster L6b.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor>https://orcid.org/0000-0002-5507-2103</terms:contributor>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-09-16T10:30:38Z</terms:date>
        <oboInOwl:hasDbXref>ILX:0770163</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#BDS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>L6b glutamatergic cortical neuron (Homo sapiens)</rdfs:label>
    </owl:Class>
