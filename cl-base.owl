    <!-- http://purl.obolibrary.org/obo/CL_0020017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000235"/>
        <obo:IAO_0000115>A macrophage that has not yet undergone polarization into a specific macrophage subtype. These cells are non-activated and have the potential to differentiate into inflammatory (M1) or alternatively activated (M2) macrophage subtypes in response to appropriate stimuli.</obo:IAO_0000115>
        <dc:creator>GitHub Copilot</dc:creator>
        <oboInOwl:hasExactSynonym>naive macrophage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>non-activated macrophage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>resting-state macrophages</oboInOwl:hasExactSynonym>
        <rdfs:label>M0 macrophage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A macrophage that has not yet undergone polarization into a specific macrophage subtype. These cells are non-activated and have the potential to differentiate into inflammatory (M1) or alternatively activated (M2) macrophage subtypes in response to appropriate stimuli.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.1186/s12885-022-09872-y</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:30861466</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
