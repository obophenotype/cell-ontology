        <obo:IAO_0000115>A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn&apos;s disease, subserosal fibroblast may differentiate into myofibroblasts.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-09-19T12:58:29Z</terms:date>
        <rdfs:label>intestinal subserosal fibroblast</rdfs:label>
    </owl:Class>
