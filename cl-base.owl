    <!-- http://purl.obolibrary.org/obo/CL_0002297 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002297">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002364"/>
        <obo:IAO_0000115>A thymic epithelial cell with moderate nuclear and cytoplasmic electron-density. Scattered in the cortex, this cell type is predominant in the mid and deep cortex.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-13T02:37:51Z</oboInOwl:creation_date>
