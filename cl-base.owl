    <!-- http://purl.obolibrary.org/obo/CL_0000486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000227"/>
