    <!-- http://purl.obolibrary.org/obo/CL_0002189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000712"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4052061"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0036457"/>
            </owl:Restriction>
        </rdfs:subClassOf>
