    <!-- http://purl.obolibrary.org/obo/CL_2000055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_2000055">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
