        <obo:IAO_0000115>A ciliated cell of the endometrial glandular epithelium. This cell is characterized by the presence of motile cilia on its apical surface.</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-02-09T11:37:30Z</terms:date>
