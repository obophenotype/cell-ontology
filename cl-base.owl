    <!-- http://purl.obolibrary.org/obo/CL_0002298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002365"/>
        <obo:IAO_0000115>A thymic epithelial cell type with low nuclear and cytoplasmic electrondensity; has a round, euchromatic nucleus and occurs in small groups at the corticomedullary junction or scattered singly in the medulla.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-13T02:37:54Z</oboInOwl:creation_date>
