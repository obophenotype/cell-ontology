        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>In primates, a diffuse bipolar 2 cell makes an average of 133 ribbon synapses, 47 contacts are with OFF parasol cells and 4 contacts are with OFF midget cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32032773</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
