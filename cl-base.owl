    <!-- http://purl.obolibrary.org/obo/CL_0000753 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000752"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002102"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008922"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An OFF-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the outer half of the inner plexiform layer. The cell body of these cells is in the middle of the inner plexiform layer. The dendritic tree is stout and the axon terminates in sublamina 1. The axonal terminal is wide and has only a few varicosities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>DB1 cone bipolar cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>type 1 cone bipolar cell (sensu Mus)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000753"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An OFF-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the outer half of the inner plexiform layer. The cell body of these cells is in the middle of the inner plexiform layer. The dendritic tree is stout and the axon terminates in sublamina 1. The axonal terminal is wide and has only a few varicosities.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:14689473</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000754 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000754">
