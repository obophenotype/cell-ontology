        <oboInOwl:hasDbXref>PMID:39451193</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_4033057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4033057">
