        <oboInOwl:hasDbXref>DOI:10.1172/JCI58779</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1186/s41038-016-0064-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.7748/ns.27.3.35.s52</oboInOwl:hasDbXref>
    </owl:Axiom>
