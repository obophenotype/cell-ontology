        <owl:annotatedTarget>Tanycyte of the third ventricle, located immediately ventral to alpha-1 tanycytes. These cells project to the ventromedial and arcuate nuclei of the hypothalamus and express the glial marker S-100β.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16344112</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26578855</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:29351662</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia:Tanycyte</oboInOwl:hasDbXref>
