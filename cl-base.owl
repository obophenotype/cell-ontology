        <oboInOwl:hasExactSynonym>zymogenic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>peptic cell</rdfs:label>
    </owl:Class>
