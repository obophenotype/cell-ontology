    <!-- http://purl.obolibrary.org/obo/CL_0008046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0008046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002103"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0008038"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/CL_0008047"/>
        <obo:IAO_0000115>A skeletal muscle fiber that is innervated by alpha motor neuron and generates tension by contracting, thereby allowing for skeletal movement. These fibers make up the large mass of skeletal muscle tissue and are attached to bones by tendons.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-26T21:06:15Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TH:H3.03.00.0.00007</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>myofibra extrafusalis</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label xml:lang="en">extrafusal muscle fiber</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0008046"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A skeletal muscle fiber that is innervated by alpha motor neuron and generates tension by contracting, thereby allowing for skeletal movement. These fibers make up the large mass of skeletal muscle tissue and are attached to bones by tendons.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.1016/B978-0-443-10321-6.00004-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Extrafusal_muscle_fiber&amp;oldid=978415293</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0008047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0008047">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0008002"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003718"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002319"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003718"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal muscle fiber that is part of a muscle spindle. These are specialized muscle fibers that serve as proprioceptors, detecting the amount and rate of change in length of a muscle. They are innervated by both sensory neurons and motor neurons (gamma and beta motorneurons, collectively referred to as fusimotor neurons).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-26T21:07:01Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>TH:H3.03.00.0.00012</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>myofibra intrafusalis</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">intrafusal muscle fiber</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0008047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A skeletal muscle fiber that is part of a muscle spindle. These are specialized muscle fibers that serve as proprioceptors, detecting the amount and rate of change in length of a muscle. They are innervated by both sensory neurons and motor neurons (gamma and beta motorneurons, collectively referred to as fusimotor neurons).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.1016/B978-0-443-10321-6.00004-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Intrafusal_muscle_fiber&amp;oldid=937508784</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0008048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0008048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000100"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000679"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002120"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0008039"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A glutamatergic motor neuron with a soma in the brainstem or cerebral cortex.  They do not synapse directly to muscles but rather to lower motor neurons, which do.  They are the main controllers of voluntary movement.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-28T09:41:48Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">upper motor neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0008048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A glutamatergic motor neuron with a soma in the brainstem or cerebral cortex.  They do not synapse directly to muscles but rather to lower motor neurons, which do.  They are the main controllers of voluntary movement.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Upper_motor_neuron&amp;oldid=943248837</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0008049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0008049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000049"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023041"/>
