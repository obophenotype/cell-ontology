        <oboInOwl:hasExactSynonym>immature neutrocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>immature neutrophil leucocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>immature neutrophil leukocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>immature neutrophilic leucocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>immature neutrophil</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000776</rdfs:seeAlso>
    </owl:Class>
