    <!-- http://purl.obolibrary.org/obo/CL_0002250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002250">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000034"/>
                    <owl:Restriction>
