            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000028>A7 interneuron</obo:IAO_0000028>
        <obo:IAO_0000115>A GABAergic cortical interneuron that is strongly labelled for α7 nAChRs. These cells have soma found in L1 and have multipolar dendrites with vertically descending axonal collaterals that project deep into the column, usually branching and terminating in L5A.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasExactSynonym>A7 cell (Mus musculus)</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#BDS_subset"/>
        <rdfs:comment>Unlike typical Lamp5 electrophysiology, A7 cells have Vip- and Sst-like firing properties, with active depolarizing hump at near-threshold membrane potentials, and  larger hyperpolarization sag, stronger burst, and rebound firing. A7 cells have a transcriptomics signature that looks like Lamp5 GABAergic interneuron.</rdfs:comment>
        <rdfs:label>alpha7 GABAergic cortical interneuron (Mmus)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4023010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A GABAergic cortical interneuron that is strongly labelled for α7 nAChRs. These cells have soma found in L1 and have multipolar dendrites with vertically descending axonal collaterals that project deep into the column, usually branching and terminating in L5A.</owl:annotatedTarget>
