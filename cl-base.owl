        <oboInOwl:hasExactSynonym>gamma-delta intraepithelial T-lymphocyte</oboInOwl:hasExactSynonym>
        <rdfs:label>gamma-delta intraepithelial T cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000801</rdfs:seeAlso>
    </owl:Class>
