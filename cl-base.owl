    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1000612">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0002584"/>
                    <owl:Restriction>
