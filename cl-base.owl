    <!-- http://purl.obolibrary.org/obo/CL_0020014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000210"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000740"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000001243"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A retinal ganglion cell that is intrinsically photosensitive, functioning as a non-image-forming photoreceptor, distinguished from rod and cone photoreceptors by the expression of the photopigment melanopsin in mice and humans (Hattar et al., 2002; Tri Hoang Do &amp; Yau, 2015). Located primarily in the ganglion cell layer with some displaced somata in the inner nuclear layer, this neuron depolarises directly in response to environmental irradiance (Tri Hoang Do &amp; Yau, 2015). It projects via the retinohypothalamic tract to central targets, including the suprachiasmatic nucleus (SCN) for circadian photoentrainment and the olivary pretectal nucleus (OPN) for the pupillary light reflex.</obo:IAO_0000115>
        <dc:creator>GitHub Copilot</dc:creator>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2473-2313"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <oboInOwl:hasBroadSynonym>photosensitive ganglion cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasRelatedSynonym>ipRGC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intrinsically photosensitive retinal ganglion cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A retinal ganglion cell that is intrinsically photosensitive, functioning as a non-image-forming photoreceptor, distinguished from rod and cone photoreceptors by the expression of the photopigment melanopsin in mice and humans (Hattar et al., 2002; Tri Hoang Do &amp; Yau, 2015). Located primarily in the ganglion cell layer with some displaced somata in the inner nuclear layer, this neuron depolarises directly in response to environmental irradiance (Tri Hoang Do &amp; Yau, 2015). It projects via the retinohypothalamic tract to central targets, including the suprachiasmatic nucleus (SCN) for circadian photoentrainment and the olivary pretectal nucleus (OPN) for the pupillary light reflex.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:11834834</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20959623</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Intrinsically_photosensitive_retinal_ganglion_cell</oboInOwl:hasDbXref>
    </owl:Axiom>
