        <oboInOwl:hasDbXref>ILX:0102311</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WikipediaVersioned:Cartwheel_cell&amp;oldid=1040398094</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
