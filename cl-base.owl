            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000028>L2/3/5 fan Martinotti sst interneuron (Mus)</obo:IAO_0000028>
        <obo:IAO_0000115>A sst GABAergic cortical interneuron that has &quot;fanning-out&apos; Martinotti morphology that is found in layer 2/3/5 of the cerebral cortex. They have local axon arbor and long ascending axons that spreads horizontally and arborizes significantly in L1.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasExactSynonym>L2/3/5 fan Martinotti SST (Mus musculus)</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#BDS_subset"/>
        <rdfs:comment>L2/3/5 fan Martionotti SST cells have an adapting firing pattern and non-zero afterdepolarization (ADP).</rdfs:comment>
        <rdfs:label>L2/3/5 fan Martinotti sst GABAergic interneuron (Mmus)</rdfs:label>
    </owl:Class>
