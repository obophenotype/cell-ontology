    <!-- http://purl.obolibrary.org/obo/CL_0002538 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002538">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_1000488"/>
