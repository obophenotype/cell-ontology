        <rdfs:comment>Location is inferred from registration of MerFish Data. Registration may be inaccurate, giving misleading location to adjacent anatomical regions.</rdfs:comment>
        <rdfs:label>OB FRMD7 GABA GABAergic neuron (Primate)</rdfs:label>
        <rdfs:seeAlso>https://knowledge.brain-map.org/abcatlas#%%3D%3D</rdfs:seeAlso>
        <rdfs:seeAlso>https://purl.brain-bican.org/taxonomy/CCN20230722/CS20250428_NEIGH_0002.h5ad</rdfs:seeAlso>
    </owl:Class>
