        <oboInOwl:hasDbXref>DOI:10.1080/19336918.2015.1089376</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1080/19336918.2015.1120397</oboInOwl:hasDbXref>
    </owl:Axiom>
