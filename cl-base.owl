        <obo:IAO_0000115>A cubodial epithelial cell that is continuous with the lining of intercalated ducts that drain the acinus. This cell type secretes a high pH solution to aid in activation of zymogens, and can differentiate into endocrine and exocrine pancreatic cell types.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-06-30T08:49:52Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>FMA:62455</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005740</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>centroacinar cell of Langerhans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pancreatic centroacinar cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>pancreatic centro-acinar cell</rdfs:label>
        <foaf:depiction>https://cdn.humanatlas.io/digital-objects/2d-ftu/pancreas-intercalated-duct/v1.2/assets/2d-ftu-pancreas-intercalated-duct.png</foaf:depiction>
