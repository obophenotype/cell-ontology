        <oboInOwl:hasDbXref>PMID:22190641</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WikipediaVersioned:Trigeminal_nerve&amp;oldid=1099897926</oboInOwl:hasDbXref>
