    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4307039"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A astrocyte of the Mus musculus brain. It is distinguished from other cells in the brain by selective expression of Gfap (Mmus), Ddn (Mmus), Myoc (Mmus), Rasl10b (Mmus). It is distinguished from other Astro-TE NN_1 cells by expression of Rasl10b, Igfbp5. These cells are located in the Hippocampal region, Isocortex, brain . Reference transcriptomic data for this type can be found in the dataset/taxonomy - Yao et al. (2023), Whole Mouse Brain in cell set Cluster:5219 Astro-TE NN_1.</owl:annotatedTarget>
