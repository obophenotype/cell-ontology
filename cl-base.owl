        <oboInOwl:hasDbXref>http://orcid.org/0000-0003-3440-1876</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0009039"/>
