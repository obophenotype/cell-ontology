    <!-- http://purl.obolibrary.org/obo/CL_0020009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000617"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0012001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002100"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002476"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000011241"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000028>GPe SOX6-CTXND1 GABA</obo:IAO_0000028>
        <obo:IAO_0000115>A GABAergic neuron located in the external globus pallidus (GPe) that constitutes approximately two-thirds of all GPe neurons (Mallet et al., 2012, Dodson et al., 2015). Derived from the medial ganglionic eminence, this cell selectively expresses Nkx2-1, with roughly two-thirds co-expressing parvalbumin (PV) and one-third lacking it in mice (Mallet et al., 2012; Dodson et al., 2015).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5507-2103"/>
        <terms:description>The prototypic neuron projects to downstream basal ganglia nuclei, including the subthalamic nucleus (STN), internal globus pallidus, and substantia nigra pars reticulata (SNr), with some neurons also emitting ascending collaterals that modestly innervate the striatum (Mallet et al., 2012, Abdi et al., 2015). It exhibits longer local axon collaterals with more boutons compared to arkypallidal neurons, supporting extensive local interconnectivity within the GPe (Mallet et al., 2012). The prototypic neuron plays a fundamental role in the indirect pathway of the basal ganglia, coordinating activity across basal ganglia nuclei through its widespread projections (Mallet et al., 2012, Courtney et al., 2023). Decreases in firing during movement are consistent with disinhibiting the STN and output nuclei, thereby facilitating the expression of desired motor patterns (Dodson et al., 2015, Courtney et al., 2023).</terms:description>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-10-17T09:12:54Z</oboInOwl:creation_date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>prototypic neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A GABAergic neuron located in the external globus pallidus (GPe) that constitutes approximately two-thirds of all GPe neurons (Mallet et al., 2012, Dodson et al., 2015). Derived from the medial ganglionic eminence, this cell selectively expresses Nkx2-1, with roughly two-thirds co-expressing parvalbumin (PV) and one-third lacking it in mice (Mallet et al., 2012; Dodson et al., 2015).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22726837</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:25843402</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:25926446</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:27194328</oboInOwl:hasDbXref>
