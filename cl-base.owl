        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sensory neuron that has the soma located in the dorsal root ganglion and expresses the marker sodium channel protein type 9 subunit alpha (Nav1.7/SCN9A). Nav1.7 accounts for approximately 50% of total sodium channel expression in human DRG and is present in 54-57% of TrkA-positive nociceptors.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:28853927</oboInOwl:hasDbXref>
