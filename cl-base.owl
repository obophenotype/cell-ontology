        <oboInOwl:hasExactSynonym>LP</oboInOwl:hasExactSynonym>
        <rdfs:label>lateral pyloric motor neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4070017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A motor neuron that controls pyloric filter movements; innervates the lateral pyloric muscle.</owl:annotatedTarget>
