    <!-- http://purl.obolibrary.org/obo/CL_4030048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002613"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023026"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002100"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0027371"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005382"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A DRD1-expressing medium spiny neuron that is part of a striosome of dorsal striatum.</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-02T14:50:43Z</terms:date>
        <oboInOwl:hasExactSynonym>striosome D1 medium spiny neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>D1-striosome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>D1S</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>striosome D1-MSN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>In Rhesus macaques, both striosomal D1 and D2 medium spiny neuron (MSN) cell types have been noted to have enriched gene expression of the following: KCNT1, KHDRBS3, FAM163A, BACH2, and KCNIP1. Striosomal MSN activations have been noted to influence cognitive and emotional decision making and value-based learning. In contrast to matrix MSNs, striosomal MSNs receive input from limbic territories, including the anterior cingulate cortex, orbitofrontal cortex, and anterior insular cortex, and project directly to midbrain dopamine neurons.</rdfs:comment>
        <rdfs:label>striosomal D1 medium spiny neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4030048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A DRD1-expressing medium spiny neuron that is part of a striosome of dorsal striatum.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>doi:10.1016/j.cub.2021.10.015</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4030048"/>
