        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An interneuron of the myenteric plexus whose axon projects aborally (in the descending direction) along the gut axis. This neuron class encompasses multiple chemically diverse subtypes including serotonergic (5-HT+), nitrergic (NOS1+), and other populations, forming the inhibitory limb of descending reflex pathways.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:34170401</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:40954253</oboInOwl:hasDbXref>
