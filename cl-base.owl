    <!-- http://purl.obolibrary.org/obo/CL_4030007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0005012"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4052018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007589"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multi-ciliated epithelial cell that is part of the fallopian tube, mainly found on the apex of the mucosal folds. This cell exhibits a columnar shape with an oval nucleus and is characterized by the presence of cilia on its surface. The coordinated beating of these cilia, together with peristaltic contractions, contributes to the self-propulsion of spermatozoa, the transport of ovum during ovulation and the transport of the fertilized ovum to the intramural fallopian tube.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0819-0473"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-03-08T12:40:19Z</terms:date>
        <oboInOwl:hasBroadSynonym>oviduct ciliated cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>fallopian tube ciliated cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fallopian tube multiciliated cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>uterine tube ciliated epithelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>fallopian tube multiciliated epithelial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4030007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-ciliated epithelial cell that is part of the fallopian tube, mainly found on the apex of the mucosal folds. This cell exhibits a columnar shape with an oval nucleus and is characterized by the presence of cilia on its surface. The coordinated beating of these cilia, together with peristaltic contractions, contributes to the self-propulsion of spermatozoa, the transport of ovum during ovulation and the transport of the fertilized ovum to the intramural fallopian tube.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16565155</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.proteinatlas.org/humanproteome/tissue/fallopian+tube</oboInOwl:hasDbXref>
    </owl:Axiom>
    


