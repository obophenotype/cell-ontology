        <oboInOwl:hasDbXref>PMID:16344112</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26578855</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:29351662</oboInOwl:hasDbXref>
