        <obo:IAO_0000115>CD4-positive, alpha-beta T cell that produces IL-22.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>T(H)-22 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th22 T cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th22 T lymphocyte</oboInOwl:hasExactSynonym>
