    <!-- http://purl.obolibrary.org/obo/CL_4033175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4033175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
