        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000222"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cell of the middle germ layer of the embryo.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MESH:D008648</oboInOwl:hasDbXref>
    </owl:Axiom>
