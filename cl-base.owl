    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000233"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A non-nucleated disk-shaped cell formed by extrusion from megakaryocytes, found in the blood of all mammals, and mainly involved in blood coagulation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:add</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dsd</oboInOwl:hasDbXref>
