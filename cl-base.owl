                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000013041"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory neuron that has the soma located in the dorsal root ganglion and expresses the pan-sensory transcription factor POU domain, class 4, transcription factor 1 (BRN3A/POU4F1). In humans, BRN3A is expressed by approximately 98% of DRG neurons and serves as a broad marker for the sensory neuron population.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-05T00:00:00Z</terms:date>
        <oboInOwl:hasExactSynonym>DRG BRN3A neuron</oboInOwl:hasExactSynonym>
        <rdfs:label>dorsal root ganglion BRN3A neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4033175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sensory neuron that has the soma located in the dorsal root ganglion and expresses the pan-sensory transcription factor POU domain, class 4, transcription factor 1 (BRN3A/POU4F1). In humans, BRN3A is expressed by approximately 98% of DRG neurons and serves as a broad marker for the sensory neuron population.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29229553</oboInOwl:hasDbXref>
    </owl:Axiom>
    


