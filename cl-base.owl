        <owl:annotatedTarget>https://cellxgene.cziscience.com/cellguide/CL_0000015</owl:annotatedTarget>
        <rdfs:label>male germ cell on CELLxGENE CellGuide</rdfs:label>
    </owl:Axiom>
    


