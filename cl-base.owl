        <oboInOwl:hasRelatedSynonym>lung macrophages</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>lung macrophage</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1001603</rdfs:seeAlso>
    </owl:Class>
