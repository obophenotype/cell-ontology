    <!-- http://purl.obolibrary.org/obo/CL_0000652 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000150"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000163"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000710"/>
