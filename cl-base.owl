        <oboInOwl:hasBroadSynonym>intraepithelial lymphocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta intraepithelial T lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta intraepithelial T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta intraepithelial T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
