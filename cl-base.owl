    <!-- http://purl.obolibrary.org/obo/CL_0020053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4047038"/>
        <obo:IAO_0000115>A Dogiel type I neuron of the myenteric plexus characterised by spiny (spine-like) dendrite morphology with numerous short projections along the dendrites. This neuron is immunopositive for neuronal nitric oxide synthase (NOS1) and immunonegative for choline acetyltransferase (ChAT), corresponding to inhibitory motor neurons of the enteric nervous system.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/cell-ontology/issues/3471"/>
        <terms:creator>GitHub Copilot</terms:creator>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-10T14:42:58Z</terms:date>
        <oboInOwl:hasExactSynonym>spiny Dogiel I neuron</oboInOwl:hasExactSynonym>
        <rdfs:label>spiny Dogiel type I neuron of myenteric plexus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020053"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Dogiel type I neuron of the myenteric plexus characterised by spiny (spine-like) dendrite morphology with numerous short projections along the dendrites. This neuron is immunopositive for neuronal nitric oxide synthase (NOS1) and immunonegative for choline acetyltransferase (ChAT), corresponding to inhibitory motor neurons of the enteric nervous system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:34170401</oboInOwl:hasDbXref>
