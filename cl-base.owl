        <oboInOwl:hasBroadSynonym>killer T-cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>killer T-lymphocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>CALOHA:TS-0190</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta cytotoxic T lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta cytotoxic T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta cytotoxic T-lymphocyte</oboInOwl:hasExactSynonym>
