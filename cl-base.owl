                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CLM_1000079"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000028>Pax6 interneuron</obo:IAO_0000028>
        <obo:IAO_0000115>A transcriptomically distinct GABAergic neuron, located in the cerebral cortex and derived from the CGE, that expresses the transcript PAX6.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0098-8958"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-10-11T13:25:51Z</terms:date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>The marker set RELN, HCRTR2 can identify the Human cell type PAX6 GABAergic interneuron in the neocortex with a confidence of 0.724125093 (NS-Forest FBeta value).</rdfs:comment>
        <rdfs:label xml:lang="en">PAX6 GABAergic interneuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4042032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A transcriptomically distinct GABAergic neuron, located in the cerebral cortex and derived from the CGE, that expresses the transcript PAX6.</owl:annotatedTarget>
