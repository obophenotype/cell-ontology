    <!-- http://purl.obolibrary.org/obo/CL_0000946 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000946">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000945"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0003000"/>
