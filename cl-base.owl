                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000049"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023095"/>
