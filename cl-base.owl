    <!-- http://purl.obolibrary.org/obo/CL_4023018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4023018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011005"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0012001"/>
