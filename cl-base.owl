    <!-- http://purl.obolibrary.org/obo/CL_0020015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1000454"/>
        <obo:IAO_0000115>A transitional cell located in the renal collecting duct that co-expresses markers of both principal cell (PC) and intercalated cell (IC). This hybrid cell is enriched in Chronic Kidney Disease (CKD).</obo:IAO_0000115>
        <dc:creator>GitHub Copilot</dc:creator>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2999-0103"/>
