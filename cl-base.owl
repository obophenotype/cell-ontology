        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>stellate neuron</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000122</rdfs:seeAlso>
        <skos:prefLabel>stellate neuron</skos:prefLabel>
    </owl:Class>
