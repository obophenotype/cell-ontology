        <oboInOwl:hasRelatedSynonym>subcapsular thymic epithelial cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>type-1 epithelial cell of thymus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
