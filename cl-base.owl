        <oboInOwl:hasDbXref>FBbt:00005123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83617</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBbt:0005409</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009052</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>motoneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>motor neuron</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000100</rdfs:seeAlso>
        <skos:prefLabel>motor neuron</skos:prefLabel>
    </owl:Class>
