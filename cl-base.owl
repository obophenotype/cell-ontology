        <oboInOwl:hasDbXref>DOI:10.1148/rg.230039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1371/journal.pone.0080463</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3892/mmr.2016.5411</oboInOwl:hasDbXref>
    </owl:Axiom>
