        <oboInOwl:hasDbXref>PMID:35720413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:39198675</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Uterine_natural_killer_cells</oboInOwl:hasDbXref>
