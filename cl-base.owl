    <!-- http://purl.obolibrary.org/obo/CL_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000255"/>
