    <!-- http://purl.obolibrary.org/obo/CL_0002379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000710"/>
        <obo:IAO_0000115>A neurecto-epithelial cell found in the arachnoid villi of dura mater. This cell type facilitates flow of cerebrospinal fluid into the blood.</obo:IAO_0000115>
