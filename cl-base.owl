                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005099"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Epithelial cell of the descending thin limb of the short loop (cortical) nephron limited to the outer medulla (mainly inner strip). It is known in some mammalian species that the short descending limb of the loop of Henle selectively expresses the serine protease Corin, the homeobox TF Uncx, and the urea channel Slc14a2.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2804-127X"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-05-13T11:00:29Z</terms:date>
        <oboInOwl:hasExactSynonym>epithelial cell of the descending thin limb of the short loop of Henle</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#added_by_HRA"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>kidney loop of Henle short descending thin limb epithelial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4030012"/>
