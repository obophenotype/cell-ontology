    <!-- http://purl.obolibrary.org/obo/CL_4042026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4042026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002614"/>
