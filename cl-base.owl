    <!-- http://purl.obolibrary.org/obo/CL_0002294 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002364"/>
        <obo:IAO_0000115>An epithelial cell with a well defined Golgi apparatus that makes up the continuous layer of cells bordering the thymic tissue beneath the capsule.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-13T02:37:23Z</oboInOwl:creation_date>
