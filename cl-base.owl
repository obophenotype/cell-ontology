                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001987"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tissue-resident macrophage that is part of the placenta. This cell helps preventing immunological rejection of the fetus by modulating the immune environment. A placental resident macrophage has high plasticity to adapt to the changing needs of each phase of pregnancy.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7655-4833"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-10-31T10:24:21Z</terms:date>
        <oboInOwl:hasBroadSynonym>placental macrophage</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#added_by_HRA"/>
        <rdfs:label>placental resident macrophage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4033087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A tissue-resident macrophage that is part of the placenta. This cell helps preventing immunological rejection of the fetus by modulating the immune environment. A placental resident macrophage has high plasticity to adapt to the changing needs of each phase of pregnancy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:39007150</oboInOwl:hasDbXref>
    </owl:Axiom>
