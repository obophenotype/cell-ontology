                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004640"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1000412"/>
