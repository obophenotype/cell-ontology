            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory neuron that has the soma located in the dorsal root ganglion and expresses the marker transient receptor potential cation channel subfamily V member 1 (TRPV1). TRPV1 is the canonical heat and capsaicin nociceptor marker and is present in approximately 54% of TrkA-positive human DRG neurons.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-05T00:00:00Z</terms:date>
