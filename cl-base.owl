    <!-- http://purl.obolibrary.org/obo/CL_4023050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4023050">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_4030065"/>
