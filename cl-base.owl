    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4023169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000029"/>
        <obo:IAO_0000115>A neuron that is responsible for sensation in the face or motor functions such as biting and chewing. Trigeminal neurons extend a single axon shaft along the lateral white matter of the hindbrain and spinal cord. The highly branched axons innervate the integument of the head.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
