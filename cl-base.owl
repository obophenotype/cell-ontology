    <!-- http://purl.obolibrary.org/obo/CL_0000510 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000150"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000323"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002563"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
