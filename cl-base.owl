        <owl:annotatedTarget>HomC</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37660146</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0020021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002320"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008019"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011026"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001995"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mesenchymal progenitor cell located in fibrocartilaginous tissues, along the fibrochondrocytic differentiation pathway that co-expresses both fibrochondrocyte markers (COL1A1, COL3A1) and mesenchymal stem cell markers (MCAM/CD146, MYLK) in humans. This cell serves as a progenitor for mature fibrochondrocytes and other meniscal cell types, with differentiation regulated by TGF-β signaling, focal adhesion, and extracellular matrix-receptor interaction pathways.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:creator>GitHub Copilot</terms:creator>
        <oboInOwl:hasRelatedSynonym>FCP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A fibrochondrocyte progenitor cell demonstrates colony-forming capacity and multi-lineage differentiation potential toward osteogenic and adipogenic lineages.</rdfs:comment>
        <rdfs:label>fibrochondrocyte progenitor cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0020021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mesenchymal progenitor cell located in fibrocartilaginous tissues, along the fibrochondrocytic differentiation pathway that co-expresses both fibrochondrocyte markers (COL1A1, COL3A1) and mesenchymal stem cell markers (MCAM/CD146, MYLK) in humans. This cell serves as a progenitor for mature fibrochondrocytes and other meniscal cell types, with differentiation regulated by TGF-β signaling, focal adhesion, and extracellular matrix-receptor interaction pathways.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31871141</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:36338137</oboInOwl:hasDbXref>
    </owl:Axiom>
