        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4030050"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A medium spiny neuron that expresses both DRD1 and DRD2 and is part of an extra-striosomal part of dorsal striatum.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>doi:10.1016/j.cub.2021.10.015</oboInOwl:hasDbXref>
    </owl:Axiom>
