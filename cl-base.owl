    <!-- http://purl.obolibrary.org/obo/CL_1001285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1001285">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_1001036"/>
                    <owl:Restriction>
