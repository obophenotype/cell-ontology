    <!-- http://purl.obolibrary.org/obo/CL_0000577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000164"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000166"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000458"/>
