    <!-- http://purl.obolibrary.org/obo/CL_4030004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002293"/>
        <obo:IAO_0000115>A large epithelial cell found in the thymus. This cell type may internalize thymocytes through extensions of plasma membrane. The cell surface and cytoplasmic vacuoles of a thymic nurse cell express MHC Class I and MHC Class II antigens. The interaction of these antigens with a developing thymocyte determines whether the thymocyte undergoes positive or negative selection.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0819-0473"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-02-18T12:43:20Z</terms:date>
        <rdfs:label>thymic nurse cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4030004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A large epithelial cell found in the thymus. This cell type may internalize thymocytes through extensions of plasma membrane. The cell surface and cytoplasmic vacuoles of a thymic nurse cell express MHC Class I and MHC Class II antigens. The interaction of these antigens with a developing thymocyte determines whether the thymocyte undergoes positive or negative selection.</owl:annotatedTarget>
