    <!-- http://purl.obolibrary.org/obo/CL_0002601 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002601">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
