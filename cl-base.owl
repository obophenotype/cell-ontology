        <obo:IAO_0000115>An epithelial cell that is part of the thyroid follicle epithelium, with a shape that ranges from squamous when inactive to cuboidal or columnar when active, reflecting its hormonal activity. Its apical surface is lined with microvilli projecting into the colloid-filled lumen, where it synthesizes, stores, and secretes the thyroid hormones thyroxine (T4) and triiodothyronine (T3), releasing them into the bloodstream in response to thyroid-stimulating hormone (TSH).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-08T01:50:08Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>BTO:0003736</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-1285</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:68782</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>follicular cell of thyroid gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>principal cell of thyroid gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thyroid gland follicular cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thyroid hormone secreting cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>thyroid follicular cell</rdfs:label>
    </owl:Class>
