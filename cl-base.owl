    <!-- http://purl.obolibrary.org/obo/CL_0000300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000300">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000586"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
