                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_P19785"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
