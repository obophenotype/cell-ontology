        <oboInOwl:hasDbXref>FMA:83434</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>white adipose cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>white fat cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>white adipocyte</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000448</rdfs:seeAlso>
    </owl:Class>
