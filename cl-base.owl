            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A supportive cell with a small, oval-shaped body and one to five telopodes. Telopodes are cytoplasmic protrusions from tens to hundreds of micrometers long and mostly below 0.2 microns of caliber.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0003-2473-2313"/>
        <oboInOwl:hasNarrowSynonym>interstitial Cajal cell-like cell</oboInOwl:hasNarrowSynonym>
