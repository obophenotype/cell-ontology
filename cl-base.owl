            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A GABAergic interneuron expressing PTHLH and PVALB that has its soma in a striatum. This GABAergic interneuron type presents a spatial expression gradient of PVALB in the mouse striatum.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0098-8958"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-09-17T10:20:15Z</terms:date>
        <oboInOwl:hasRelatedSynonym>PTHLH/PVALB cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PTHLH +/PVALB+ interneuron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>According to spatial transcriptomic data in the human striatum, pthlh-expressing interneurons are one of the most abundant population of interneurons in the striatum (Leonardo D. Garma, et al., 2024).</rdfs:comment>
        <rdfs:label xml:lang="en">striatal pthlh-expressing interneuron</rdfs:label>
    </owl:Class>
