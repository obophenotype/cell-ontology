    <!-- http://purl.obolibrary.org/obo/CL_4023007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4023007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000103"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023016"/>
