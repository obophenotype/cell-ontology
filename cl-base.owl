    <!-- http://purl.obolibrary.org/obo/CL_4040000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4040000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000123"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011115"/>
        <obo:IAO_0000115>A glial precursor cell that generates oligodendrocytes and type-1 and type-2 astrocytes. It has been shown in some mammals that this cell type may express A2B5, nestin, FGFR-1, FGFR-2, FGFR-3, PLP, and DM-20 antigens. Unlike oligodendrocyte precursor cell, it does not initially express PDGFR-alpha and can differentiate into both type-1 and type-2 astrocytes.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0819-0473"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-04-03T14:54:32Z</terms:date>
        <oboInOwl:hasBroadSynonym>glial restricted precursor</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>tripotential glial-restricted precursor cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>GRP cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>glial restricted tripotential precursor cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4040000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A glial precursor cell that generates oligodendrocytes and type-1 and type-2 astrocytes. It has been shown in some mammals that this cell type may express A2B5, nestin, FGFR-1, FGFR-2, FGFR-3, PLP, and DM-20 antigens. Unlike oligodendrocyte precursor cell, it does not initially express PDGFR-alpha and can differentiate into both type-1 and type-2 astrocytes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:10719353</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
